# Target: ESP32-S3
CONFIG_IDF_TARGET_ESP32S3=y

# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash settings
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM — Octal mode (ESP32-S3R8 on Waveshare board; see vendor sdkconfig)
# RAM/PSRAM budget sanity check (v1.0 expected consumers):
#   - Audio ring buffer (Task 6):      ~128KB  (4 sec × 2ch × 16-bit × 16kHz)
#   - ESP-SR AFE model (Task 8):       ~200KB  (smallest NS/VAD/AGC model set, esp-sr)
#   - LCD framebuffer (Task 2):        ~115KB  (240×240 × 16bpp × double-buffer)
#   - Wi-Fi/BLE stack heap:            ~80KB
#   - FreeRTOS task stacks + misc:     ~80KB
#   Total estimated PSRAM:             ~600KB — well within 8MB PSRAM, fits alongside
#                                       internal RAM (512KB SRAM) for time-critical code
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Wi-Fi driver needs internal (non-PSRAM) RAM for its RX/TX DMA buffer
# pools at esp_wifi_init() time — 32KB reserve was too tight and left
# esp_wifi_init() failing with ESP_ERR_NO_MEM ("wifi: malloc buffer
# fail"), which aborts the Wi-Fi task and reboots the device. Bumped to
# match the ~80KB Wi-Fi/BLE budget documented above.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=81920
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# By the time esp_wifi_init() runs, internal RAM is too tight for its
# static buffer pools (ESP_ERR_NO_MEM / "alloc eb fail"). Let Wi-Fi/LWIP
# fall back to the 8MB PSRAM instead of failing outright.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_DEFAULT_PSRAM_CLK_IO=30
CONFIG_DEFAULT_PSRAM_CS_IO=26

# I2C for codec
CONFIG_I2C_MASTER_ISR_IRAM_SAFE=n

# Default 100Hz tick (10ms/tick) silently truncates any vTaskDelay(pdMS_TO_TICKS(n))
# with n<10 to 0 ticks, turning intended short sleeps (buttons.c, audio_capture.c,
# audio_process.c, recorder.c all use 1-5ms delays) into bare yields — those tasks
# then spin at full priority and starve their core's idle task past the watchdog
# timeout. 1000Hz gives 1ms/tick so sub-10ms delays round correctly.
CONFIG_FREERTOS_HZ=1000

# FatFs long filename support — default LFN_NONE only allows 8.3 short
# names, so mkdir("/sdcard/echo-pocket") (11 chars) fails with EINVAL and
# SD storage falls back to "continuing without storage".
CONFIG_FATFS_LFN_HEAP=y

# Partition table (custom for 16MB flash)
CONFIG_PARTITION_TABLE_CUSTOM=y

# app_main() runs the entire init sequence (SD/FAT mount, display, audio,
# Wi-Fi, TLS client setup) directly on the main task before spawning any
# worker tasks — the 3584-byte IDF default overflows partway through SD
# mount. Bump it to cover that sequence with headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# By the time esp_wifi_init() runs, display/SD/I2S/ES7210 init has already
# claimed most of the ~173KB internal-RAM budget, leaving well under the
# IDF-default WiFi buffer pools' requirement — esp_wifi_init() aborted with
# ESP_ERR_NO_MEM ("wifi: malloc buffer fail"), rebooting the device. This
# is a single-STA recorder, not a high-throughput AP, so trim the buffer
# counts to fit comfortably in what's actually available.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
